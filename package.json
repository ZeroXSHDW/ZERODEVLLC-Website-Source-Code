{
  "name": "zerodevllc-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern coverage --max-warnings=0",
    "security": "node scripts/security-check.mjs",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf .next out",
    "dev:turbo": "next dev --turbo",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "format": "prettier --write \"app/**/*.{js,jsx,ts,tsx,json,css,md}\" \"components/**/*.{js,jsx,ts,tsx,json,css,md}\" \"config/**/*.{js,jsx,ts,tsx,json,css,md}\" \"lib/**/*.{js,jsx,ts,tsx,json,css,md}\" \"*.{js,jsx,ts,tsx,json,css,md,mjs}\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"app/**/*.{js,jsx,ts,tsx,json,css,md}\" \"components/**/*.{js,jsx,ts,tsx,json,css,md}\" \"config/**/*.{js,jsx,ts,tsx,json,css,md}\" \"lib/**/*.{js,jsx,ts,tsx,json,css,md}\" \"scripts/**/*.{js,mjs}\" \"*.{js,jsx,ts,tsx,json,css,md,mjs}\" \".github/**/*.yml\"",
    "quality": "npm run security && npm run type-check && npm run lint && npm run format:check && npm run test:coverage && npm audit --audit-level=moderate && npm run build",
    "analyze": "ANALYZE=true npm run build",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@loadable/component": "^5.16.7",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@react-three/postprocessing": "^2.19.1",
    "@react-three/xr": "^5.7.1",
    "@types/loadable__component": "^5.13.10",
    "@use-gesture/react": "^10.3.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "draco3d": "^1.5.6",
    "framer-motion": "^10.18.0",
    "lucide-react": "^0.294.0",
    "next": "16.3.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "three-stdlib": "^2.35.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.6.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.42",
    "@types/react-dom": "^18.2.17",
    "@types/three": "^0.185.4",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "autoprefixer": "^10.5.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.5.2",
    "postcss": "^8.4.32",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.2"
  },
  "resolutions": {
    "three": "^0.185.1",
    "@react-three/fiber": "^8.18.0",
    "@react-three/drei": "^9.122.0",
    "@react-three/postprocessing": "^2.19.1",
    "@react-three/xr": "^5.7.1"
  }
}
